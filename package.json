{
  "name": "hauntrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && npm --prefix viewer run test",
    "demo:shortlet": "npm run build && node dist/apps/shortlet-pricing/src/cli.js",
    "demo:npc": "npm run build && node dist/apps/haunted-npc/src/cli.js",
    "viewer:dev": "npm --prefix viewer run dev",
    "viewer:build": "npm --prefix viewer install && npm --prefix viewer run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
